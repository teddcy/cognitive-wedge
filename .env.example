# Copy to .env (or set these in your host's dashboard). Nothing here is committed.
PORT=3000
BASE_URL=https://your-domain.example      # used in every emailed link
DB_PATH=./data/wedge.db                   # put this on a persistent disk

# Agent
ANTHROPIC_API_KEY=
WEDGE_MODEL=claude-sonnet-5-5
WEDGE_CLASSIFIER_MODEL=claude-haiku-5-5
AGENT_NAME=Wedge

# Staff dashboard: comma-separated allowlist, sign-in by emailed one-time link
STAFF_EMAILS=you@company.com

# Email (without SMTP_URL, links are only logged, and shown at /dev/outbox in dev mode)
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Cognitive Wedge <no-reply@your-domain.example>"

# Data
RETENTION_DAYS=365

# Optional day-30 question: "Are the tasks you handed over now being done on <platform>?"
PLATFORM_CHECK=0
PLATFORM_NAME=the platform

# Local testing only
DEV_MODE=0
MOCK_LLM=0
